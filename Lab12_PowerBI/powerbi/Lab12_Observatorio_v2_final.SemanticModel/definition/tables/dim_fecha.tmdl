				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"fecha", type date}, {"anio", Int64.Type}, {"trimestre", type text}, {"mes_num", Int64.Type}, {"mes", type text}, {"periodo", type text}}, "en-US")
				in
				    Tipos

