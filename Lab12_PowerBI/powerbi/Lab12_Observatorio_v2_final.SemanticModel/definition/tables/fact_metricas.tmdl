table fact_metricas
	lineageTag: 3f1a6696-210b-4b42-93cc-0c041e81b9e0

	column serie_id
		dataType: string
		lineageTag: 681fa423-ff54-4539-9e4c-e0fe219432e1
		summarizeBy: none
		sourceColumn: serie_id

	column prueba
		dataType: string
		lineageTag: a7d066cc-27d7-495b-a303-d970313e2d41
		summarizeBy: none
		sourceColumn: prueba

	column modelo_id
		dataType: int64
		lineageTag: 675609df-3e5b-4bd3-804f-e810533ccc59
		summarizeBy: none
		sourceColumn: modelo_id

	column MAE
		dataType: double
		formatString: #,0.00
		lineageTag: 4316ca94-19e0-4d75-b400-e0c28208f5f2
		summarizeBy: sum
		sourceColumn: MAE

	column RMSE
		dataType: double
		formatString: #,0.00
		lineageTag: ce35e82c-142c-44a5-be85-dedcdc9c60d1
		summarizeBy: sum
		sourceColumn: RMSE

	column MAPE
		dataType: double
		formatString: #,0.00
		lineageTag: 3eebcbc4-d9ca-4aaf-8a22-27f92af3ee30
		summarizeBy: sum
		sourceColumn: MAPE

	partition fact_metricas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_metricas.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"serie_id", type text}, {"prueba", type text}, {"modelo_id", Int64.Type}, {"MAE", type number}, {"RMSE", type number}, {"MAPE", type number}}, "en-US")
				in
				    Tipos

